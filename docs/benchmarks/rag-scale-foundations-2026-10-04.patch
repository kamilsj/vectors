+        assert_eq!(
+            original.tables["items"].rows[0][1],
+            Value::Text("before".into())
+        );
+        // Once detached, another mutable access must not copy the table again.
+        assert!(std::ptr::eq(
+            staged.tables.get_mut("items").unwrap(),
