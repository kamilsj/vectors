# Copy to .env.local and restrict permissions: chmod 600 .env.local
# vectors-server loads .env.local from its working directory at startup.
# Use --env-file PATH to choose another private file.
# Existing environment variables take precedence, including empty values.
# Values are literal: no shell commands, variable expansion, or escape sequences.
# Leave unused credentials blank. Never commit the populated local file.

# OpenAI text embeddings
OPENAI_API_KEY=

# Voyage text embeddings and reranking
VOYAGE_API_KEY=
